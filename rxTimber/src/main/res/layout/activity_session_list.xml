<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <!-- 頂部標題區域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="16dp">

        <!-- 標題和操作按鈕區域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Log Sessions"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2c3e50" />

            <!-- 操作按鈕容器 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_export_db"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_outline_blue"
                    android:text="匯出資料庫"
                    android:textColor="#3498db"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textStyle="bold"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_clear_all_log"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/button_outline_red"
                    android:text="清除全部"
                    android:textStyle="bold"
                    android:textColor="#e74c3c"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 操作提示 -->
        <TextView
            android:id="@+id/tv_delete_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="💡 短按分享 Session，長按刪除"
            android:textColor="#7f8c8d"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 主要內容區域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp">

        <!-- Session列表 -->
        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:choiceMode="singleChoice"
            android:divider="#e0e0e0"
            android:dividerHeight="1dp"
            android:elevation="2dp"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="16dp"
            />

        <!-- 空視圖 -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="48sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="沒有找到任何 Session"
                android:textColor="#7f8c8d"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="開始使用應用程式來記錄日誌"
                android:textColor="#bdc3c7"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 載入指示器 -->
        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#3498db" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="載入中..."
                android:textColor="#7f8c8d"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>