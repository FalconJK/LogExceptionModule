<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- 自動初始化 ContentProvider -->
        <provider
            android:name="com.falconjk.rxTimber.logdb.ShortcutInstaller"
            android:authorities="${applicationId}.rxTimber.shortcut.installer"
            android:exported="false"
            android:initOrder="100"
            tools:node="merge" />

        <!-- SessionList Activity -->
        <activity
            android:name="com.falconjk.rxTimber.logdb.activity.SessionListActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Light.NoActionBar"
            />

        <!-- FileProvider 配置 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>